# ==============================================================================
# OD&IS Stream 2 — GCP Deployment & Operations Template (Makefile.example)
# ==============================================================================
# Copy this file to Makefile (which is gitignored) and customize variables,
# or define them in .env / .env.deploy.
# ==============================================================================

-include .env
-include .env.deploy

PROJECT_ID := odis-stream2-app
REGION := europe-west1
STAGING_SOURCE_BUCKET := gs://odis-stream2-app-cloudbuild-euw1
DATASETS_BUCKET := odis-stream2-app-data-euw1
REPOSITORY := odis-stream2-repo
SHARES_BUCKET := odis-stream2-app-shares-euw1
GIT_SHA ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
TAG ?= $(GIT_SHA)

.PHONY: help deploy-staging promote-prod deploy-datasets harden-buckets test lint setup-monitoring

help:
	@echo "OD&IS Stream 2 - Operations Commands:"
	@echo "  make deploy-staging [TAG=<sha>]   Build and deploy candidate to staging Cloud Run (default TAG: current git short SHA)"
	@echo "  make promote-prod TAG=<sha>       Promote verified image digest from staging to production Cloud Run"
	@echo "  make deploy-datasets RUN_ID=<id>  Publish validated pipeline candidate datasets to GCS release bucket"
	@echo "  make harden-buckets               Apply UBLA, PAP, and retention lifecycles to GCS buckets and Artifact Registry"
	@echo "  make setup-monitoring             Deploy Cloud Monitoring Uptime Check and Alerting Policies to GCP"
	@echo "  make test                         Run local unit tests via uv pytest"
	@echo "  make lint                         Run local ruff and ty quality checks"

deploy-staging:
	@if [ "$(TAG)" = "unknown" ] || [ -z "$(TAG)" ]; then \
		echo "ERROR: Valid Git SHA or TAG required for deploy-staging." >&2; exit 1; \
	fi
	@echo "Submitting staging build for TAG: $(TAG) to regional source bucket: $(STAGING_SOURCE_BUCKET)/source"
	gcloud builds submit . \
		--project=$(PROJECT_ID) \
		--region=$(REGION) \
		--config=cloudbuild.yaml \
		--gcs-source-staging-dir=$(STAGING_SOURCE_BUCKET)/source \
		--substitutions=_IMAGE_TAG=$(TAG)

promote-prod:
	@if [ -z "$(TAG)" ] || [ "$(TAG)" = "REQUIRED" ] || [ "$(TAG)" = "unknown" ]; then \
		echo "ERROR: Must specify approved immutable TAG=<short-sha> to promote to production." >&2; \
		echo "Example: make promote-prod TAG=428cc48" >&2; \
		exit 1; \
	fi
	@echo "Promoting verified image TAG: $(TAG) to production Cloud Run"
	gcloud builds submit . \
		--project=$(PROJECT_ID) \
		--region=$(REGION) \
		--config=cloudbuild-promote.yaml \
		--gcs-source-staging-dir=$(STAGING_SOURCE_BUCKET)/source \
		--substitutions=_IMAGE_TAG=$(TAG)

deploy-datasets:
	@if [ -z "$(RUN_ID)" ]; then \
		echo "ERROR: Must specify RUN_ID=<candidate-run-id> to deploy datasets." >&2; \
		echo "Example: make deploy-datasets RUN_ID=run-20260828T144045Z-236d0f3f" >&2; \
		exit 1; \
	fi
	@echo "Deploying candidate datasets $(RUN_ID) to gs://$(DATASETS_BUCKET)..."
	GCS_DATASETS_BUCKET=$(DATASETS_BUCKET) uv run python -m pipeline.etl --step deploy --run-id $(RUN_ID)

harden-buckets:
	@echo "Configuring Uniform Bucket-Level Access on $(STAGING_SOURCE_BUCKET)..."
	gcloud storage buckets update $(STAGING_SOURCE_BUCKET) --uniform-bucket-level-access
	@echo "Configuring Public Access Prevention on $(STAGING_SOURCE_BUCKET)..."
	gcloud storage buckets update $(STAGING_SOURCE_BUCKET) --public-access-prevention
	@echo "Applying 7-day source lifecycle rule on $(STAGING_SOURCE_BUCKET)..."
	gcloud storage buckets update $(STAGING_SOURCE_BUCKET) --lifecycle-file=.agents/infra/retention/lifecycle_cloudbuild_7d.json
	@echo "Applying 1-year sliding lifecycle rule on gs://$(SHARES_BUCKET)..."
	gcloud storage buckets update gs://$(SHARES_BUCKET) --lifecycle-file=.agents/infra/retention/lifecycle_shares_1y.json
	@echo "Configuring Artifact Registry cleanup policies on $(REPOSITORY)..."
	gcloud artifacts repositories set-cleanup-policies $(REPOSITORY) --project=$(PROJECT_ID) --location=$(REGION) --policy=.agents/infra/retention/artifact_registry_cleanup.json --no-dry-run
	@echo "Retention policies and bucket hardening complete."

test:
	uv run pytest tests/unit -v

lint:
	uv run ruff check app tests
	uv run ty check app

setup-monitoring:
	@chmod +x scripts/setup_monitoring.sh
	PROJECT_ID=$(PROJECT_ID) CHAT_CHANNEL_ID="$(CHAT_CHANNEL_ID)" EMAIL_CHANNEL_ID="$(EMAIL_CHANNEL_ID)" ./scripts/setup_monitoring.sh
