# Ignore everything by default
*

# Allow app directory
!app/
!data/

# Ignore specific heavy items inside app/ if any (though !app/ allows it, we can be specific if needed)
# But generally we want app/
# We definitely want to ignore these in the root if they weren't caught by *
# Explicitly ignore hidden files/folders in root (since * misses them)
.git
.venv/
venv
.DS_Store
.pytest_cache
.gitignore
__pycache__
*.pyc
.ipynb_checkpoints
.agent

# Ignore specific files/folders within app/
app/__pycache__
app/.pytest_cache
app/.logs/
app/.logs/*
app/tests
app/*.pyc
app/.DS_Store
app/.env
app/.streamlit/secrets.toml
app/data_private/
app/data/datasets/
app/data/*.parquet
!app/data/odis_referentiels.parquet
app/data/shared_searches/
pipeline/data_private/
**/.env
