# Ignore everything by default
*

# Allow app directory
!app/
!tests/
!scripts/
!pyproject.toml
!uv.lock
!.python-version
!requirements-dev.txt
!cloudbuild.yaml
!cloudbuild-promote.yaml
!.dockerignore
!ruff.toml
!ty.toml
!pytest.ini

# Explicitly ignore hidden files/folders in root (since * misses them)
.git
.venv/
venv
.DS_Store
.pytest_cache
.gitignore
__pycache__
*.pyc
.ipynb_checkpoints
.agent

# Ignore specific files/folders within app/
app/__pycache__
app/.pytest_cache
app/.logs
# app/tests
app/*.pyc
app/.DS_Store
app/.env
app/.streamlit/secrets.toml
app/data_private/
app/data/datasets/
app/data/*.parquet
app/data/shared_searches/
**/.env
