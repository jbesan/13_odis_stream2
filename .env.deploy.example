# ==============================================================================
# OD&IS Stream 2 — GCP Deployment Environment Variables Template
# ==============================================================================
# Copy this file to .env.deploy (which is gitignored) and fill in your values.
# ==============================================================================

# Target GCP Project ID for Cloud Run and Secret Manager
ODIS_GCP_PROJECT_ID=your-gcp-project-id

# Target GCP Region for Cloud Run & regional storage (default: europe-west1)
ODIS_GCP_REGION=europe-west1

# Regional Cloud Build source staging bucket (URI format: gs://<bucket-name>)
ODIS_GCP_CLOUDBUILD_BUCKET=gs://your-project-cloudbuild-euw1
